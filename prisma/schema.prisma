generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id               String  @id @default(cuid())
  name             String
  legalName        String?
  dba              String?
  organizationType String

  primaryContact String
  email          String
  phone          String?
  website        String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?

  accreditations   String[]
  ownerClerkUserId String   @unique

  facilities        Facility[]
  users             User[]
  evidence          Evidence[]
  standards         Standard[]
  operationalTopics OperationalTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Facility {
  id           String @id @default(cuid())
  name         String
  facilityType String

  primaryAccreditor      String?
  accreditations         String[] @default([])
  cmsCertificationNumber String?
  facilityAdministrator  String?
  medicalDirector        String?
  safetyOfficer          String?
  timeZone               String?
  facilityAddress        String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  evidence     Evidence[]
  capabilities FacilityCapability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([facilityType])
  @@index([primaryAccreditor])
}

model FacilityCapability {
  id String @id @default(cuid())

  capability String
  enabled    Boolean @default(true)

  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facilityId, capability])
  @@index([facilityId])
  @@index([capability])
  @@index([enabled])
}

model User {
  id        String  @id
  email     String  @unique
  firstName String?
  lastName  String?

  role             String @default("Staff")
  accessScope      String @default("All Facilities")
  invitationStatus String @default("Active")

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Evidence {
  id          String  @id @default(cuid())
  title       String
  description String?

  fileName      String
  fileUrl       String?
  fileType      String?
  fileSize      Int?
  extractedText String? @db.Text

  category       String?
  status         String    @default("Draft")
  ownerName      String?
  expirationDate DateTime?
  uploadedAt     DateTime  @default(now())
  documentDate   DateTime?

  complianceYear    Int?
  complianceMonth   Int?
  complianceQuarter Int?

  periodStart DateTime?
  periodEnd   DateTime?

  frequency    String?
  evidenceType String?

  serviceProvider String?
  performedBy     String?

  isRecurring    Boolean @default(false)
  analysisStatus String  @default("Pending")
  analysisError  String? @db.Text

  analysisDocumentType    String?
  analysisDepartment      String?
  analysisConfidence      Float?
  analysisEvidenceQuality Float?
  analysisSurveyReadiness Float?
  analysisRiskLevel       String?

  analysisStrengths               String[] @default([])
  analysisRecommendations         String[] @default([])
  analysisRecommendedStandards    String[] @default([])
  analysisMissingEvidence         String[] @default([])
  analysisStandardRecommendations Json     @default("[]")
  analysisExecutiveSummary        String?  @db.Text
  analysisSummary                 String?  @db.Text

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  facilityId String?
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  standardMappings         EvidenceStandard[]
  operationalTopicMappings EvidenceOperationalTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([facilityId])
  @@index([status])
  @@index([analysisStatus])
  @@index([complianceYear])
  @@index([complianceYear, complianceMonth])
  @@index([facilityId, complianceYear, complianceMonth])
  @@index([evidenceType])
  @@index([frequency])
}

model Standard {
  id String @id @default(cuid())

  accreditor String
  chapter    String?
  code       String
  slug       String?
  title      String

  intent      String? @db.Text
  description String? @db.Text
  requirement String? @db.Text

  surveyorLooksFor String[] @default([])
  evidenceExamples String[] @default([])
  commonFindings   String[] @default([])
  keywords         String[] @default([])
  aiGuidance       String?  @db.Text

  referencedAuthorities Json?

  evidenceFrequency String?
  evidenceRetention String?
  responsibleRole   String?
  validationMethod  String?

  department String?
  domain     String?
  category   String?
  riskLevel  String?
  priority   Int     @default(1)

  version       String?
  effectiveDate DateTime?
  status        String    @default("Active")
  sourceUrl     String?
  isCustom      Boolean   @default(false)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  evidenceMappings         EvidenceStandard[]
  operationalTopicMappings StandardOperationalTopic[]
  applicabilityRules       StandardApplicabilityRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([accreditor])
  @@index([chapter])
  @@index([code])
  @@index([domain])
  @@index([category])
  @@index([status])
  @@index([slug])
}

model StandardApplicabilityRule {
  id String @id @default(cuid())

  ruleType  String
  ruleValue String
  effect    String  @default("Include")
  ruleGroup String  @default("default")
  matchMode String  @default("All")
  notes     String? @db.Text

  standardId String
  standard   Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([standardId, ruleType, ruleValue, effect, ruleGroup])
  @@index([standardId])
  @@index([ruleType])
  @@index([ruleValue])
  @@index([effect])
  @@index([ruleGroup])
}

model OperationalTopic {
  id String @id @default(cuid())

  code String
  slug String
  name String

  description String? @db.Text
  aiGuidance  String? @db.Text

  domain   String?
  category String?

  displayOrder Int     @default(100)
  icon         String?
  color        String?

  riskLevel String?
  priority  Int     @default(1)

  keywords         String[] @default([])
  evidenceExamples String[] @default([])
  surveyorLooksFor String[] @default([])
  commonFindings   String[] @default([])

  evidenceFrequency String?
  evidenceRetention String?
  responsibleRole   String?
  validationMethod  String?

  status   String  @default("Active")
  isCustom Boolean @default(false)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  standardMappings StandardOperationalTopic[]
  evidenceMappings EvidenceOperationalTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, organizationId])
  @@unique([slug, organizationId])
  @@index([organizationId])
  @@index([domain])
  @@index([category])
  @@index([status])
  @@index([displayOrder])
}

model StandardOperationalTopic {
  id String @id @default(cuid())

  standardId String
  standard   Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  operationalTopicId String
  operationalTopic   OperationalTopic @relation(fields: [operationalTopicId], references: [id], onDelete: Cascade)

  relationshipType String  @default("Applies To")
  notes            String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([standardId, operationalTopicId])
  @@index([standardId])
  @@index([operationalTopicId])
}

model EvidenceOperationalTopic {
  id String @id @default(cuid())

  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  operationalTopicId String
  operationalTopic   OperationalTopic @relation(fields: [operationalTopicId], references: [id], onDelete: Cascade)

  mappingSource String  @default("Manual")
  confidence    Float?
  notes         String? @db.Text

  isVerified Boolean   @default(false)
  verifiedBy String?
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([evidenceId, operationalTopicId])
  @@index([evidenceId])
  @@index([operationalTopicId])
  @@index([isVerified])
}

model EvidenceStandard {
  id String @id @default(cuid())

  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  standardId String
  standard   Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  mappingSource String  @default("Manual")
  confidence    Float?
  notes         String? @db.Text

  evidenceStrength    String?
  mappedRequirements  String[] @default([])
  missingRequirements String[] @default([])
  surveyImpact        String?  @db.Text

  isVerified Boolean   @default(false)
  verifiedBy String?
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([evidenceId, standardId])
  @@index([evidenceId])
  @@index([standardId])
  @@index([isVerified])
  @@index([evidenceStrength])
}
